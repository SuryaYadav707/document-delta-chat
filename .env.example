# Copy to .env and fill in. NEVER commit .env.

# --- LLM provider (default: openai) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...                 # required when LLM_PROVIDER=openai
LLM_CHAT_MODEL=gpt-4o-mini            # cheap model for chat answers
LLM_REASON_MODEL=gpt-4o               # stronger model for judge / vision verify
EMBED_MODEL=text-embedding-3-small

# --- AWS Bedrock (drop-in alternative; set LLM_PROVIDER=bedrock) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Langfuse (self-hosted observability) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- Paths / runtime (override config/default.yaml) ---
# CONFIG_PATH=config/default.yaml
# CHROMA_DIR=.chroma
# ARTIFACTS_DIR=artifacts
# TRACES_DIR=traces
